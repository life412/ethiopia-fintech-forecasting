# Load enriched dataset
data = pd.read_csv('../data/processed/ethiopia_fi_enriched.csv')

# Access (Account Ownership) over time
access_data = data[data['indicator_code']=='ACC_OWNERSHIP']
plt.figure(figsize=(8,5))
sns.lineplot(x='observation_date', y='value_numeric', data=access_data, marker='o')
plt.title('Ethiopia Account Ownership (Access) 2011-2024')
plt.ylabel('Account Ownership (%)')
plt.show()

# Usage (Digital Payment)
usage_data = data[data['indicator_code']=='USG_DIGITAL_PAYMENT']
plt.figure(figsize=(8,5))
sns.lineplot(x='observation_date', y='value_numeric', data=usage_data, marker='o')
plt.title('Ethiopia Digital Payment Usage 2011-2024')
plt.ylabel('Usage (%)')
plt.show()

# Correlations (numeric indicators)
numeric_df = data.pivot_table(
    index='observation_date',
    columns='indicator_code',
    values='value_numeric'
)
sns.heatmap(numeric_df.corr(), annot=True, cmap='coolwarm')
plt.title("Correlation Between Financial Inclusion Indicators")
plt.show()
