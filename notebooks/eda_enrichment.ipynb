# notebooks/eda_enrichment.ipynb

# Imports
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Load data
data = pd.read_csv('../data/raw/ethiopia_fi_unified_data.csv')
reference_codes = pd.read_csv('../data/raw/reference_codes.csv')

# Quick overview
print(data.head())
print(data.info())
print(data['record_type'].value_counts())

# Explore indicators
print(data['indicator_code'].unique())
print(data.groupby('record_type')['value_numeric'].describe())

# Temporal coverage
data['observation_date'] = pd.to_datetime(data['observation_date'])
plt.figure(figsize=(10,4))
sns.countplot(x=data['observation_date'].dt.year, hue=data['record_type'])
plt.title("Temporal Coverage by Record Type")
plt.show()

# Merge enrichment ideas
# Example: Add smartphone penetration data
smartphone_df = pd.DataFrame({
    'indicator_code': ['SMARTPHONE_PEN'],
    'observation_date': [pd.Timestamp('2024-01-01')],
    'value_numeric': [35],  # %
    'source_name': ['GSMA'],
    'record_type': ['observation'],
    'pillar': None
})
data = pd.concat([data, smartphone_df], ignore_index=True)

# Save processed dataset
data.to_csv('../data/processed/ethiopia_fi_enriched.csv', index=False)

