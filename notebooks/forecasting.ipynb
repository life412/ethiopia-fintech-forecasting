from statsmodels.tsa.holtwinters import ExponentialSmoothing

# Load access data
access_data = data[data['indicator_code']=='ACC_OWNERSHIP']
access_ts = access_data.set_index('observation_date')['value_numeric'].asfreq('YS')  # Year Start frequency

# Fit simple ETS model
model = ExponentialSmoothing(access_ts, trend='add', seasonal=None)
fit = model.fit()
forecast = fit.forecast(3)  # 2025-2027

print("Access Forecast 2025-2027:")
print(forecast)

# Usage forecast
usage_data = data[data['indicator_code']=='USG_DIGITAL_PAYMENT']
usage_ts = usage_data.set_index('observation_date')['value_numeric'].asfreq('YS')
model_usage = ExponentialSmoothing(usage_ts, trend='add', seasonal=None)
fit_usage = model_usage.fit()
forecast_usage = fit_usage.forecast(3)

print("Usage Forecast 2025-2027:")
print(forecast_usage)
