# Load enriched data
data = pd.read_csv('../data/processed/ethiopia_fi_enriched.csv')

# Separate events and impact_links
events = data[data['record_type']=='event']
impact_links = data[data['record_type']=='impact_link']

# Merge to get which event affects which indicator
event_matrix = impact_links.merge(events, left_on='parent_id', right_on='id', how='left')

# Example: visualize effects of events
import seaborn as sns
plt.figure(figsize=(10,6))
sns.heatmap(event_matrix.pivot_table(
    index='event_name', columns='related_indicator', values='impact_magnitude'
), annot=True, cmap='vlag')
plt.title("Event Impact on Indicators")
plt.show()
